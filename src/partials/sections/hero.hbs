<section id="inicio" class="p-4 md-p-8 lg-py-12">
  <div class="row align-items-center gap-6">

    <!-- Columna Izquierda: Contenido de Texto y Botones -->
    <div class="col-12 lg-col-6">
      <span class="hero-subtitle mb-2 block font-bold text-primary">
        {{hero_subtitle}}
      </span>

      <h1 class="hero-title mb-4">
        {{hero_title}}
      </h1>

      <p class="hero-description mb-6">
        {{hero_description}}
      </p>

      <div class="row gap-3">
        <a href="./services.html" class="btn btn-primary">{{hero_btn_primary}}</a>
        <a href="./contact.html" class="btn btn-secondary">{{hero_btn_secondary}}</a>
      </div>
    </div>

    <!-- Columna Derecha: Imagen Principal -->
    <div class="col-12 lg-col-6">
      <div class="hero-img-container">
        <img src="{{hero_img}}" alt="{{hero_title}}" class="cover-img rounded-lg" />
      </div>
    </div>

  </div>
</section>
