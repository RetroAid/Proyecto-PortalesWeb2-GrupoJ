<section id="contacto">
    <div>
        <div>
            <header>
                <h2>{{contact_title}}</h2>
                <p>{{contact_subtitle}}</p>
            </header>

            <ul>
                <li>
                    <strong>Teléfono / WhatsApp:</strong>
                    <p>{{contact_phone_1}}</p>
                </li>
                <li>
                    <strong>Ubicación:</strong>
                    <address>{{contact_address}}</address>
                </li>
                <li>
                    <strong>Horario de Atención:</strong>
                    <p>{{contact_schedule}}</p>
                </li>
            </ul>
        </div>

        <div>
            <form action="#" method="POST">
                <h3>Envíanos una Consulta</h3>

                <div>
                    <label for="user-name">Nombre Completo</label>
                    <input type="text" id="user-name" name="name" required />
                </div>

                <div>
                    <label for="user-phone">Teléfono / WhatsApp</label>
                    <input type="tel" id="user-phone" name="phone" required />
                </div>

                <div>
                    <label for="user-message">Consulta o Especie del Paciente</label>
                    <textarea id="user-message" name="message" rows="4" required></textarea>
                </div>

                <button type="submit">{{contact_btn}}</button>
            </form>
        </div>
    </div>
</section>